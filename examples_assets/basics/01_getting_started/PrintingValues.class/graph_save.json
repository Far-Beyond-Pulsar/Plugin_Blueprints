        ],
        "contained_node_ids": [
          "n",
          "b",
          "f",
          "w",
          "e"
        ]
      },
      {
        "id": "comment-3",
        "text": "BUILDING A MESSAGE\nPure nodes (no white pins) such as Number To String and String Concat compute a value when something needs it. Here their result flows through the blue/pink data wires into Print String.",
        "position": [
          360.0,
          270.0
        ],
        "size": [
          760.0,
          110.0
        ],
        "color": [
